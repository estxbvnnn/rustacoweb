# ==========================================================
#  Rustaco.co — configuración del backend
#
#  Copiá este archivo a `.env` y completá los valores:
#      cp .env.example .env
#
#  El `.env` está en .gitignore y NUNCA debe commitearse.
# ==========================================================

# --- Entorno ---
# development | production
NODE_ENV=production

# --- Servidor HTTP ---
# Detrás de Nginx dejá HOST=127.0.0.1 para que el puerto 3001
# no quede expuesto directamente a internet.
PORT=3001
HOST=127.0.0.1

# --- URLs públicas (OBLIGATORIAS en production) ---
# Deben coincidir EXACTAMENTE con el dominio que tiene el SSL.
# Si acá ponés la IP o http://, el callback de Steam falla.
SERVER_PUBLIC_URL=https://rustaco.co
CLIENT_URL=https://rustaco.co

# Orígenes extra permitidos por CORS, separados por coma (opcional)
EXTRA_CORS_ORIGINS=

# --- Sesiones (OBLIGATORIO) ---
# Generar uno nuevo con:  openssl rand -hex 32
SESSION_SECRET=

# --- Steam (OBLIGATORIO) ---
# Obtenerla en https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# SteamIDs con acceso al panel de administración, separados por coma
ADMIN_STEAM_IDS=76561198416933402

# --- MySQL ---
# DB_ENABLED=false  -> stats desactivadas y tickets guardados en tickets.json
# DB_ENABLED=true   -> DB_HOST/DB_USER/DB_PASSWORD/DB_NAME pasan a ser obligatorios
DB_ENABLED=false
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
